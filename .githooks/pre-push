#!/bin/sh
# Refuses a push whose commits contain a path with a `fixtures` segment.
# Checks every pushed commit, not only the tip. Never bypass it with --no-verify.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # a deleted ref pushes no commits
  node build/fixture-paths.ts --range "$remote_sha" "$local_sha" || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused." >&2
fi
exit "$status"
