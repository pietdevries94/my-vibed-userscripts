{
  "name": "Fix Tweakers",
  "description": "Trims the Tweakers homepage.",
  "features": [
    {
      "category": "Homepage",
      "points": [
        "Hides the lead story",
        "Hides the side columns",
        "Hides the top banner",
        "Hides the category bar"
      ]
    }
  ],
  "match": ["https://tweakers.net/*"],
  "grant": ["GM_addStyle"],
  "version": "1.0.3",
  "mode": "open",
  "runAt": "document-start",
  "signInOrigins": ["https://myprivacy.dpgmedia.nl"],
  "cdnOrigins": [
    "https://myprivacy-static.dpgmedia.net",
    "https://tweakers.net",
    "https://ic.tweakimg.net",
    "https://tweakimg.net"
  ]
}
